{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cleanbg",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "vars": {
    "VITE_APP_URL": "https://cleanbg.app",
    "VITE_APP_NAME": "CleanBG",
    "VITE_MODEL_HOST": "/models",
    "VITE_GITHUB_URL": "https://github.com/coolbat/cleanbg"
  },
  "r2_buckets": [
    {
      "binding": "MODELS",
      "bucket_name": "cleanbg-models"
    }
  ],
  "routes": [
    { "pattern": "cleanbg.app", "custom_domain": true },
    { "pattern": "www.cleanbg.app", "custom_domain": true }
  ]
}
