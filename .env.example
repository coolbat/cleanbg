# CleanBG — environment variables
#
# Local development:
#   cp .env.example .env.development
#
# Every variable is public (VITE_ prefix, injected into the client bundle).
# This site has no server-side secrets.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
VITE_APP_URL=http://localhost:3000
VITE_APP_NAME=CleanBG
VITE_APP_DESCRIPTION=Free background remover that runs entirely in your browser. No uploads, no limits.
VITE_APP_LOGO=/logo.png
VITE_DEFAULT_LOCALE=en

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
# Self-hosted model mirror (Cloudflare R2 behind a custom domain). Leave empty
# to load models straight from huggingface.co. See scripts/upload-models.ts.
# Example: https://models.cleanbg.app
VITE_MODEL_HOST=

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
VITE_GA_ID=
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SRC=

# ---------------------------------------------------------------------------
# Links (optional — footer/socials hidden when empty)
# ---------------------------------------------------------------------------
VITE_GITHUB_URL=
VITE_X_URL=
